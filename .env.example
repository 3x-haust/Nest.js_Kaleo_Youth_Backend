# ── 서버 ─────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# API 앞에서 신뢰할 역방향 프록시 홉 수. 직접 노출 시 0.
TRUST_PROXY_HOPS=0
# 쿠키를 주고받을 프론트 출처 (CORS 화이트리스트, 쉼표 구분)
CORS_ORIGINS=http://localhost:3000

# ── 데이터베이스 (docker-compose.yml과 값 공유) ──────
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=kaleo
DB_PASSWORD=kaleo_local_pw
DB_DATABASE=kaleo_youth
# 개발 중 스키마 자동 동기화. 운영에서는 반드시 false + 마이그레이션 사용
DB_SYNCHRONIZE=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# TLS를 제공하지 않는 사설망 managed DB에서만 true. 공개 DB 호스트에는 적용되지 않습니다.
ALLOW_INSECURE_INTERNAL_DB=false

# ── 인증 ─────────────────────────────────────────────
# openssl rand -hex 32 로 생성한 값을 넣으세요. 두 값은 서로 달라야 합니다.
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# 로컬 http 개발 시 false, 운영(https)에서는 반드시 true
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── 최초 슈퍼관리자 시딩 ────────────────────────────
# 앱 최초 기동 시 admins 테이블이 비어 있을 때만 1회 생성됩니다.
# 운영 환경에서는 일회성 시딩이 필요한 배포에서만 true 로 설정하세요.
ALLOW_PRODUCTION_ADMIN_SEED=false
SEED_SUPER_ADMIN_LOGIN_ID=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=최고관리자

# ── 파일 업로드 ─────────────────────────────────────
UPLOAD_DIR=./uploads
# 업로드된 파일이 서빙되는 공개 베이스 URL
PUBLIC_BASE_URL=http://localhost:4000

# ── YouTube Data API v3 ─────────────────────────────
# 비워두면 모든 YouTube 자동 연동이 비활성화됩니다.
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT_MS=5000
# 설교 채널. 비워두면 자동 설교 등록이 비활성화됩니다.
# 허용 형식: UC... 채널 ID, youtube.com/channel/UC..., @handle, youtube.com/@handle
# 매일 Asia/Seoul 오전 4시(0 4 * * *)에 최신 일반 공개 영상 최대 50개를 확인합니다.
# 라이브 방송, 예정된 라이브, 라이브 다시보기는 자동 등록하지 않습니다.
YOUTUBE_SERMON_CHANNEL=@수도교회-청소년부
# 비워두면 박정인 목사로 등록됩니다.
YOUTUBE_SERMON_PREACHER_NAME=박정인 목사
